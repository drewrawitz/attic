# Copy this file to .env and fill it in. .env is ignored by git.
# The README says where each value comes from.

# A Cloudflare API token and the id of the account it deploys to. Only a deploy uses these.
# `vp run dev` and the tests run on local simulators.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional. The address to serve Attic from, such as attic.example.com. The zone must already
# be in the account. Leave it empty to use the Worker's workers.dev address.
ATTIC_DOMAIN=

# Optional. The timezone you live in, as an IANA name such as America/New_York. It is where
# the tools read today's date, which decides whether a Property is still current on its last
# day. Leave it empty for UTC. A deploy stops if it is not a timezone.
ATTIC_TIMEZONE=

# Optional. The currency your amounts are in, as an ISO code such as USD or EUR. Attic stores an
# amount as a plain number, so this is only used to write one out in a Note, such as $450.00.
# Leave it empty for USD. A deploy stops if it is not a currency.
ATTIC_CURRENCY=

# Sign-in with Google. A deploy stops if one of these is empty. `vp run dev` starts without
# them, and the sign-in page then says which one is missing.
# The id and secret of the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Google accounts that may sign in, separated by commas. Everyone else is turned away.
ALLOWED_EMAILS=

# Leave these two out. The tests set them to point the Worker at a stand-in for Google.
# `vp run dev` reads them too, and a deploy never does: it always uses Google's own addresses.
# GOOGLE_TOKEN_URL=
# GOOGLE_USERINFO_URL=
