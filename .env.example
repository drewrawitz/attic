# Copy this file to .env and fill it in. .env is ignored by git.
# Only a deploy uses these. `vp run dev` and the tests run on local simulators and need none.

# A Cloudflare API token and the id of the account it deploys to.
# The README lists the permissions the token needs.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional. The address to serve Attic from, such as attic.example.com. The zone must already
# be in the account. Leave it empty to use the Worker's workers.dev address.
ATTIC_DOMAIN=
